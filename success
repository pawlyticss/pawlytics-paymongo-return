<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Pawlytics Payment Success</title>
</head>
<body>
  <p>Redirecting back to Pawlytics…</p>
  <p id="fallback" style="display:none;">
    If nothing happens, tap:
    <a id="openApp" href="#">Open Pawlytics</a>
  </p>

  <script>
    const params = new URLSearchParams(window.location.search);
    const ref = params.get("ref") || "";
    const deepLink = "pawlytics://payment/success?ref=" + encodeURIComponent(ref);

    // Try auto-open app
    window.location.href = deepLink;

    // Show fallback link after a moment
    setTimeout(() => {
      document.getElementById("openApp").href = deepLink;
      document.getElementById("fallback").style.display = "block";
    }, 1200);
  </script>
</body>
</html>
